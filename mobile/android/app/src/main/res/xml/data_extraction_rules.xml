<?xml version="1.0" encoding="utf-8"?>
<!-- Saved printer logins (API keys, access codes) stay on the device, and so
     does the print queue: its G-code is large and only means something there. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="printers.xml" />
        <exclude domain="file" path="print-queue/" />
        <exclude domain="file" path="print-queue.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="printers.xml" />
        <exclude domain="file" path="print-queue/" />
        <exclude domain="file" path="print-queue.json" />
    </device-transfer>
</data-extraction-rules>
